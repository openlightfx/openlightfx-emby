<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenLightFX.Emby</RootNamespace>
    <AssemblyName>OpenLightFX.Emby</AssemblyName>
    <Version>1.0.3</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Emby SDK References -->
  <ItemGroup>
    <Reference Include="MediaBrowser.Common">
      <HintPath>../../lib/MediaBrowser.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>../../lib/MediaBrowser.Controller.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Model">
      <HintPath>../../lib/MediaBrowser.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Emby.Web.GenericEdit">
      <HintPath>../../lib/Emby.Web.GenericEdit.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.29.*" />
    <PackageReference Include="Grpc.Tools" Version="2.70.*" PrivateAssets="All" />
  </ItemGroup>

  <!-- Protobuf Compilation -->
  <ItemGroup>
    <Protobuf Include="Proto/lightfx.proto" GrpcServices="None" />
  </ItemGroup>

  <!--
    StudioVersion selects the openlightfx-studio GitHub Release whose
    openlightfx-studio-dist.zip asset is embedded. "latest" follows the
    newest release. A missing release embeds a placeholder page instead
    of failing the build. Override with: dotnet build -p:StudioVersion=v1.2.3
  -->
  <PropertyGroup>
    <StudioVersion Condition="'$(StudioVersion)' == ''">latest</StudioVersion>
    <!-- Set inside the target. IntermediateOutputPath is still empty while this file is read. -->
    <StudioDistZip>$(MSBuildProjectDirectory)/obj/studio-dist/openlightfx-studio-dist.zip</StudioDistZip>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(StudioDistZip)">
      <LogicalName>OpenLightFX.Emby.Studio.dist.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="FetchOpenLightFXStudio" BeforeTargets="PrepareResourceNames;CoreCompile">
    <MakeDir Directories="$(MSBuildProjectDirectory)/obj/studio-dist" />
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\..\build\FetchStudioDist\FetchStudioDist.csproj&quot; -c Release -- &quot;$(StudioVersion)&quot; &quot;$(StudioDistZip)&quot;" />
  </Target>

</Project>
